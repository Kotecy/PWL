{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PWL",
  "version": "1.0.0",
  "identifier": "ru.kotecy.pwl",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node tools/dev-server.mjs",
    "beforeBuildCommand": "node tools/build-assets.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PWL by Kotecy",
        "width": 900,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "backgroundColor": "#1b1d21",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Менеджер аккаунтов Perfect World",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}